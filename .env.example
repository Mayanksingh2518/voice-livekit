# ---------------------------------------------------------------- LiveKit
# cloud.livekit.io -> your project -> Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- Model providers
# The agent LLM, the post-call analysis and the Opik judges all use LLM_PROVIDER.
# gemini has a genuinely free tier (no card); openai needs credits. Both run through the
# OpenAI client — Gemini via its OpenAI-compatible endpoint.
LLM_PROVIDER=gemini            # gemini | openai

# aistudio.google.com/apikey  — free, no card required
GEMINI_API_KEY=
# platform.openai.com/api-keys — needs credits
OPENAI_API_KEY=

DEEPGRAM_API_KEY=              # console.deepgram.com — free credits, does both STT and TTS
CARTESIA_API_KEY=              # optional, only if TTS_PROVIDER=cartesia

# Gemini's free tier is 20 requests/day PER MODEL, so each role uses a different
# model to spread the quota. Any of gemini-3.x-flash works.
LLM_MODEL=gemini-3.5-flash     # gpt-4o-mini when LLM_PROVIDER=openai
ANALYSIS_MODEL=gemini-3.6-flash
ANALYSIS_MAX_ATTEMPTS=4        # free tiers return 429/503 routinely; these are retried

DEEPGRAM_MODEL=nova-3          # STT
TTS_PROVIDER=deepgram          # deepgram | openai | cartesia
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en
# CARTESIA_VOICE_ID=
# OPENAI_TTS_VOICE=shimmer

# ---------------------------------------------------------------- Opik
# comet.com/opik -> your workspace -> API key
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=livekit-voice-agent
# OPIK_URL_OVERRIDE=http://localhost:5173/api   # self-hosted only

OPIK_ENABLED=true              # false disables sending; the call and analysis still run
OPIK_SDK_SCORING=true          # in-process judge metrics at call end
OPIK_JUDGE_MODEL=gemini/gemini-3.7-flash   # LiteLLM name; judge for the SDK metrics
OPIK_FLUSH_TIMEOUT=15
OPIK_TRANSCODE_AUDIO=true      # ogg -> wav via ffmpeg, for reliable playback in the Opik UI

# ---------------------------------------------------------------- Telephony
# Only needed for real outbound calls. Leave blank to use `python main.py console`.
# Fill these, then run: python scripts/setup_sip_trunk.py
SIP_TRUNK_ADDRESS=             # e.g. my-trunk.pstn.twilio.com  (no sip: prefix)
SIP_TRUNK_NUMBER=              # caller ID in E.164, e.g. +15105550123
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_NAME=healthcare-outbound

# Printed by setup_sip_trunk.py — required to place a call
SIP_OUTBOUND_TRUNK_ID=

# Where transfer_to_human sends the call
TRANSFER_TO=

# ---------------------------------------------------------------- Behaviour
AGENT_NAME=healthcare-outbound-caller
DEFAULT_PATIENT_ID=P001
MAX_CALL_DURATION_S=600
USER_AWAY_TIMEOUT=20
REDACT_PHI=false               # true masks phone numbers before anything reaches Opik
LOG_LEVEL=INFO
